# Environment Configuration Template
# Copy this file to .env and update with your local IP address

# Replace YOUR_LOCAL_IP with your computer's IP address
# Find it by running: ipconfig (Windows) or ifconfig (Mac/Linux)
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LOCAL_IP:3004
EXPO_PUBLIC_SOCKET_URL=http://YOUR_LOCAL_IP:3004

# Example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3004
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:3004
