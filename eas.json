{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
      ,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "@secret:EXPO_PUBLIC_API_BASE_URL",
        "EXPO_PUBLIC_SOCKET_URL": "@secret:EXPO_PUBLIC_SOCKET_URL"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
