{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
      ,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://lynq-chat-app-production.up.railway.app",
        "EXPO_PUBLIC_SOCKET_URL": "https://lynq-chat-app-production.up.railway.app"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
